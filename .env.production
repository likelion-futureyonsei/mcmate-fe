# Production serves the SPA and the API from the same host
# (https://mcmate.dohan.in and https://mcmate.dohan.in/api/v1), so relative
# paths are all that is needed and no CORS setup is involved.
VITE_API_BASE_URL=/api/v1

# nginx does not currently route /media to Django, so uploaded photos 404 into
# the SPA's index.html. Screens fall back to the bundled artwork when that
# happens; point this at wherever MEDIA_URL is really served to show real shots.
VITE_MEDIA_BASE_URL=/media
