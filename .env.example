# Django backend the dev server proxies /api/v1 and /media to.
# The backend ships without django-cors-headers, so keep requests same-origin.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Only needed when the API is not reachable under the same origin as the SPA.
# Production values live in .env.production.
# VITE_API_BASE_URL=/api/v1
# VITE_MEDIA_BASE_URL=/media
